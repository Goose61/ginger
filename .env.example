# ─── REQUIRED ─────────────────────────────────────────────────────────────────
#
# MongoDB Atlas connection string
# Create a free cluster at https://cloud.mongodb.com
# Network access → allow 0.0.0.0/0 (or Vercel IP range)
# Database access → create a user with readWrite on "crypgo" database
# Connect → Drivers → copy the SRV connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/crypgo?retryWrites=true&w=majority

# ─── OPTIONAL: VERCEL BLOB (legacy collections only) ───────────────────────
#
# No longer required for new launches — ZIPs are parsed in the browser and
# assets upload to Arweave from the creator wallet at go-live.
# Still used to serve collections created before the client-import flow.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_<token>

# ─── REQUIRED FOR PRODUCTION ──────────────────────────────────────────────────
#
# Comma-separated list of your production + preview origins.
# Example: https://gingernft.store,https://www.gingernft.store
# Leave empty in .env.local for local dev (all origins allowed).
ALLOWED_ORIGINS=https://gingernft.store,https://www.gingernft.store

# ─── OPTIONAL: SOLANA / ARWEAVE ───────────────────────────────────────────────
#
# Platform wallet private key (base58) — required for on-chain minting:
#   • Metaplex Core collection creation at marketplace go-live
#   • Platform co-sign on asset mint transactions (Phantom pays rent)
# Gift/collection storage upload is paid by the minter via Phantom when using Irys.
# ⚠️  ROTATE THIS KEY if it was ever committed to git or shared.
ARWEAVE_SOLANA_KEY=<base58-private-key>
# Optional public-only override when the secret is set elsewhere (must match ARWEAVE_SOLANA_KEY pubkey)
# PLATFORM_WALLET=<platform-wallet-pubkey>

# Metaplex Core Collection for uncompressed Core mints (paid drops / legacy gifts).
# Create once: npm run setup:mainnet-collection
# CORE_COLLECTION_ADDRESS=<core-collection-pubkey>
# CORE_COLLECTION_ADDRESS_DEVNET=<devnet-collection-pubkey>
# CORE_COLLECTION_ADDRESS_MAINNET=hRiamu3d97ujzHZGCkSjwLNj5GQ5nVnMsmfJqgxB9v7
# CORE_COLLECTION_NAME=Dough Boi
# CORE_COLLECTION_URI=https://gateway.irys.xyz/...
#
# Compressed gift mints (Bubblegum V2). Create once:
#   npx tsx scripts/setup-bubblegum-tree.ts          # devnet
#   npx tsx scripts/setup-bubblegum-tree.ts --mainnet
# BUBBLEGUM_TREE_ADDRESS=
# BUBBLEGUM_TREE_ADDRESS_DEVNET=
# BUBBLEGUM_TREE_ADDRESS_MAINNET=
# BUBBLEGUM_COLLECTION_ADDRESS=
# BUBBLEGUM_COLLECTION_ADDRESS_DEVNET=
# BUBBLEGUM_COLLECTION_ADDRESS_MAINNET=
# BUBBLEGUM_COLLECTION_URI=
#
# MongoDB id/slug for the bundled gift collection on /market (default: dough-boi-gifts)
# GIFT_BUNDLE_COLLECTION_ID=dough-boi-gifts
#
# Legacy Token Metadata gifts (maintenance scripts only — not used for new mints):
# GIFT_TM_COLLECTION_MINT=<collection-nft-mint-pubkey>
# GIFT_TM_COLLECTION_MINT_MAINNET=<mainnet-collection-nft-mint-pubkey>
# GIFT_COLLECTION_NAME=Dough Boi
# GIFT_COLLECTION_URI=https://arweave.net/your-collection-metadata.json

# Active cluster: devnet (testing) or mainnet (production)
SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet

SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
SOLANA_RPC_URL_MAINNET=https://api.mainnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL_MAINNET=https://api.mainnet.solana.com

# To go live: set SOLANA_NETWORK and NEXT_PUBLIC_SOLANA_NETWORK to `mainnet`
# and restart the dev server / redeploy.

# Platform treasury for holder/buyback royalty splits in metadata (optional)
# PLATFORM_TREASURY_WALLET=<solana-pubkey>

# ─── SLICEPAY (REAL PAYMENTS) ─────────────────────────────────────────────────
#
# SlicePay hosted checkout: https://slicechain.io/website-pay-widget/
# Checkout: https://pay.slicechain.io  API: https://api.slicechain.io/api/gateway
#
# Merchant ID is public (used on checkout URLs). Ginger's business id is built in;
# set SLICEPAY_MERCHANT_ID only to override it.
#   SLICEPAY_API_KEY — required; secret key from Business dashboard → Settings (gateway API)
#
# Optional webhook:
#   SLICEPAY_WEBHOOK_SECRET=<random-string-you-choose>
#   Webhook URL: https://YOUR-DOMAIN.com/api/slicepay/webhook
#
# Buyers return to:
#   /collection/{id}?slicepay=1&tokenId=…&invoiceId=…&status=paid&tx=…
#
SLICEPAY_MERCHANT_ID=6aac0279fa934d1d2f844cf4
SLICEPAY_API_KEY=
# SLICEPAY_WEBHOOK_SECRET=

# ─── BETA FEEDBACK EMAIL ────────────────────────────────────────────────────────
#
# Feedback form posts to /api/feedback and emails the team via Resend.
# RESEND_API_KEY is required. FEEDBACK_FROM_EMAIL must use a domain verified
# in the same Resend account (https://resend.com/domains).
#
# FEEDBACK_EMAIL_TO=slicepay@slicechain.io
# FEEDBACK_FROM_EMAIL=Ginger Beta <feedback@gingernft.store>  # optional; this is the default
# RESEND_API_KEY=re_...

# ─── SEO: SEARCH CONSOLE, BING, ANALYTICS ────────────────────────────────────
#
# Sitemap (submit this URL in Google Search Console and Bing Webmaster Tools):
#   https://www.gingernft.store/sitemap.xml
# robots.txt allows public pages and blocks /api and /dashboard.
#
# Google Search Console HTML-tag verification (content value only, not the full tag):
# GOOGLE_SITE_VERIFICATION=
# Bing Webmaster meta verification (content value of msvalidate.01):
# BING_SITE_VERIFICATION=
# GA4 measurement id. Leave unset until the property exists. CSP allows gtag only when set.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── AVALANCHE (C-CHAIN + OPTIONAL L1) ───────────────────────────────────────
#
# Launch + destination mint. Ginger pays $0; AVALANCHE_MINTER_KEY is the prepaid
# gas wallet (home debit / operator). Fund it from the checkout gas float only.
#
# Fuji (test):
#   AVALANCHE_NETWORK=fuji
#   NEXT_PUBLIC_AVALANCHE_NETWORK=fuji
#   AVALANCHE_MINTER_KEY=0x... npm run deploy:avalanche-factory
#   then set AVALANCHE_FACTORY_ADDRESS_FUJI and AVALANCHE_L1_REMOTE_ADDRESS
#
# Mainnet (production):
#   1. Fund the minter with real AVAX on C-Chain (43114)
#   2. AVALANCHE_NETWORK=mainnet npm run deploy:avalanche-factory
#   3. Set the printed AVALANCHE_FACTORY_ADDRESS_MAINNET
#   4. Flip both network vars to mainnet and redeploy the web app
#   5. Do NOT set AVALANCHE_L1_RPC_URL to the C-Chain RPC. L1 minting stays
#      off until you have a dedicated L1 endpoint.
#
AVALANCHE_NETWORK=fuji
NEXT_PUBLIC_AVALANCHE_NETWORK=fuji
# AVALANCHE_RPC_URL_FUJI=https://api.avax-test.network/ext/bc/C/rpc
# AVALANCHE_RPC_URL_MAINNET=https://api.avax.network/ext/bc/C/rpc
# NEXT_PUBLIC_AVALANCHE_RPC_URL_FUJI=https://api.avax-test.network/ext/bc/C/rpc
# NEXT_PUBLIC_AVALANCHE_RPC_URL_MAINNET=https://api.avax.network/ext/bc/C/rpc
#
# After deploy:
# AVALANCHE_FACTORY_ADDRESS_FUJI=0x
# AVALANCHE_FACTORY_ADDRESS_MAINNET=0x
# AVALANCHE_FACTORY_ADDRESS=0x
# AVALANCHE_L1_REMOTE_ADDRESS=0x
# AVALANCHE_L1_RPC_URL=
# AVALANCHE_PLATFORM_WALLET=0x
# AVALANCHE_MINTER_KEY=0x

